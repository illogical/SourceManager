{
  "server": {
    "frontendPort": 17116,
    "allowedIps": []
  },
  "repos": [
    {
      "id": "my-web-app",
      "displayName": "My Web App",
      "repoPath": "my-web-app",
      "defaultBranch": "main",
      "services": [
        {
          "id": "my-web-app-web",
          "displayName": "Web",
          "packageManager": "auto",
          "scriptName": "dev",
          "port": 3000,
          "healthUrl": "http://localhost:3000/health",
          "healthMode": "ping",
          "tags": ["web"],
          "allowedIps": []
        },
        {
          "id": "my-web-app-api",
          "displayName": "API",
          "packageManager": "bun",
          "scriptName": "api",
          "port": 8080,
          "healthUrl": "http://localhost:8080/health",
          "healthMode": "full",
          "tags": ["api"],
          "allowedIps": ["192.168.1.0/24"],
          "tailnetExposureMode": "tailscale-service",
          "tailscaleServiceName": "my-app-api",
          "tailscaleServiceEnabled": false,
          "tailscaleServiceProtocol": "https",
          "tailscaleServicePort": 443,
          "tailscaleServiceTarget": "http://127.0.0.1:8080"
        }
      ]
    },
    {
      "id": "my-backend",
      "displayName": "My Backend",
      "repoPath": "my-backend",
      "defaultBranch": "main",
      "services": [
        {
          "id": "my-backend-server",
          "displayName": "Server",
          "packageManager": "npm",
          "scriptName": "start:dev",
          "port": 4000,
          "healthUrl": "http://localhost:4000/health",
          "healthMode": "full",
          "tags": ["backend"],
          "allowedIps": []
        }
      ]
    }
  ]
}
