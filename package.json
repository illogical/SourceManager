{
  "name": "source-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run build && tsx watch src/standalone.ts",
    "build": "npm run clean && npm run typecheck && npm run frontend:build && npm run build:server && npm run build:manifest",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild src/standalone.ts --bundle --platform=node --format=esm --outfile=dist/standalone.js --packages=external && esbuild src/host/index.ts --bundle --platform=node --format=esm --outfile=dist/host/index.js --packages=external",
    "build:manifest": "node scripts/build-manifest.mjs",
    "start": "node dist/standalone.js",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "verify:host": "node scripts/verify-host.mjs dist/host/index.js",
    "verify:fixture": "node scripts/verify-sibling-fixture.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "socket.io": "^4.8.3",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
